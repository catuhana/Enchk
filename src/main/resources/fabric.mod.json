{
  "schemaVersion": 1,
  "id": "enchk",
  "name": "Enchk",
  "description": "Enchantment cracking",
  "version": "${mod_version}",
  "environment": "client",
  "license": "LGPL-3.0-or-later",
  "icon": "assets/enchk/icon.png",
  "authors": [
    "tuhana"
  ],
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.catuhana.enchk.Enchk"
      }
    ]
  },
  "depends": {
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "betterconfig": "*"
  },
  "mixins": [
    {
      "config": "enchk.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "enchk.classtweaker"
}
